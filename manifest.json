{
  "name": "captk-brats-pipeline",
  "label": "CaPTk - BraTS Pipeline",
  "description": "Pre-processing pipeline using CaPTk tools (BraTSPipeline v1.8.1).",
  "author": "D3b-TIRU",
  "maintainer": "D3b-TIRU <flywheel@d3b.center>",
  "source": "https://github.com/d3b-center/fw-captk-brats-pipeline",
  "url": "https://cbica.github.io/CaPTk/preprocessing_brats.html",
  "version": "0.1.6",
  "license": "Apache-2.0",
  "custom": {
    "gear-builder": {
      "category": "analysis",
      "image": "chop.flywheel.io/captk-brats-pipeline:0.1.6"
    },
    "flywheel": {
      "suite": "CaPTk"
    }
  },
  "inputs": {
    "T1": {
      "base": "file",
      "optional": true,
      "description": "T1-weighted image no contrast agent (nifti).",
      "type": {
        "enum": [
          "nifti"
        ]
      }
    },
    "T1CE": {
      "base": "file",
      "optional": true,
      "description": "T1-weighted image with contrast agent (nifti).",
      "type": {
        "enum": [
          "nifti"
        ]
      }
    },
    "T2": {
      "base": "file",
      "optional": true,
      "description": "T2-weighted image (nifti).",
      "type": {
        "enum": [
          "nifti"
        ]
      }
    },
    "FLAIR": {
      "base": "file",
      "optional": true,
      "description": "Fluid attenuated inversion recovery image (nifti).",
      "type": {
        "enum": [
          "nifti"
        ]
      }
    },
    "ADC": {
      "base": "file",
      "optional": true,
      "description": "Diffusion ADC image (nifti).",
      "type": {
        "enum": [
          "nifti"
        ]
      }
    }
  },
  "config": {
    "run_deepmedic_skullstripping": {
      "default": false,
      "description": "Whether to run DeepMedic-based skullstripping after pre-processing (default: False)",
      "type": "boolean"
    },
    "run_deepmedic_tumorsegmentation": {
      "default": false,
      "description": "Whether to run DeepMedic-based tumor segmentation (BraTS pretrained model) after pre-processing (default: False)",
      "type": "boolean"
    },
    "save_intermediate_files": {
      "default": false,
      "description": "Whether to save intermediate files (default: False)",
      "type": "boolean"
    },
    "debug": {
      "default": false,
      "description": "Whether to print debugging information (default: False)",
      "type": "boolean"
    }
  },
  "environment": {
    "CAPTK_VERSION": "1.8.1",
    "FLYWHEEL": "/flywheel/v0",
    "HOME": "/root",
    "HOSTNAME": "0b633f948575",
    "LD_LIBRARY_PATH": "/opt/captk/1.8.1/usr/lib/",
    "MESA_GL_VERSION_OVERRIDE": "3.2",
    "OLDPWD": "/opt/captk/1.8.1/usr",
    "PATH": "/opt/captk/1.8.1/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "PWD": "/flywheel/v0",
    "QT_GRAPHICSSYSTEM": "native",
    "QT_X11_NO_MITSHM": "1",
    "SHLVL": "1",
    "TERM": "xterm"
  }
}